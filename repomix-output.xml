<file path="app/page.js">
'use client';

import dynamic from 'next/dynamic';
import { useCallback, useEffect, useRef, useState } from 'react';
import SearchBar from '../components/SearchBar';
import BottomSheet from '../components/BottomSheet';
import ParamsPanel from '../components/ParamsPanel';
import Resultados from '../components/Resultados';
import Modal from '../components/Modal';
import { COMBUSTIBLES, DEFAULTS, dentroDeCobertura } from '../lib/config';
import { parseMiles } from '../lib/format';
import {
  calcularMejorOpcion,
  direccionDesdeCoordenadas,
  obtenerEstacionesCercanas,
  obtenerRuta,
} from '../lib/api';

const MapView = dynamic(() => import('../components/MapView'), { ssr: false });

const PARAMS_INICIALES = {
  marca: '',
  modelo: '',
  anio: '',
  rendimiento: String(DEFAULTS.rendimientoKmL),
  combustible: DEFAULTS.combustible,
  modo: 'dinero',
  cantidad: '',
  radioKm: DEFAULTS.radioKm,
};

const MSG_FUERA_COBERTURA =
  'Dirección no encontrada dentro del área de cobertura. Por favor, intenta con otra referencia o selecciona directamente en el mapa';

export default function Home() {
  const [origen, setOrigen] = useState(null);
  const [direccion, setDireccion] = useState('');
  const [errorDireccion, setErrorDireccion] = useState('');
  const [enfocarBuscador, setEnfocarBuscador] = useState(0);

  const [params, setParams] = useState(PARAMS_INICIALES);
  const [cargado, setCargado] = useState(false);

  const [estadoSheet, setEstadoSheet] = useState('medio');
  const [alturaSheet, setAlturaSheet] = useState(0);
  const [vista, setVista] = useState('parametros');

  const [buscando, setBuscando] = useState(false);
  const [resultado, setResultado] = useState(null);
  const [seleccionadaId, setSeleccionadaId] = useState(null);

  const [ruta, setRuta] = useState(null);
  const [rutaDeId, setRutaDeId] = useState(null);
  const [cargandoRuta, setCargandoRuta] = useState(null);
  const [errorRuta, setErrorRuta] = useState('');

  const [modal, setModal] = useState(null);
  const [aviso, setAviso] = useState('');
  const geoPedida = useRef(false);
  const origenManual = useRef(false); // true cuando el usuario eligió el origen a mano
  const origenSeq = useRef(0); // identifica la última elección de origen

  // Persistencia local de parámetros (no hay cuentas ni base de datos)
  useEffect(() => {
    try {
      const guardado = JSON.parse(localStorage.getItem('benciruta-params') || 'null');
      if (guardado) {
        // REQ-EP1-04: si el combustible guardado no es válido, forzar 95 y avisar
        if (!COMBUSTIBLES.some((c) => c.id === guardado.combustible)) {
          guardado.combustible = DEFAULTS.combustible;
          setAviso('Se ha seleccionado 95 Octanos por defecto');
        }
        setParams({ ...PARAMS_INICIALES, ...guardado });
      }
    } catch {
      /* almacenamiento no disponible */
    }
    setCargado(true);
  }, []);

  useEffect(() => {
    if (!cargado) return;
    try {
      localStorage.setItem('benciruta-params', JSON.stringify(params));
    } catch {
      /* ignorar */
    }
  }, [params, cargado]);

  useEffect(() => {
    if (!aviso) return;
    const t = setTimeout(() => setAviso(''), 3500);
    return () => clearTimeout(t);
  }, [aviso]);

  const limpiarResultados = useCallback(() => {
    setResultado(null);
    setRuta(null);
    setRutaDeId(null);
    setSeleccionadaId(null);
    setErrorRuta('');
    setVista('parametros');
  }, []);

  // REQ-EP1-02: fija el origen validando la cobertura (RN-01)
  const elegirOrigen = useCallback(
    async (lat, lng, texto, desdeGps = false) => {
      if (!dentroDeCobertura(lat, lng)) {
        setErrorDireccion(MSG_FUERA_COBERTURA);
        return;
      }
      origenManual.current = !desdeGps;
      const seq = ++origenSeq.current;
      setErrorDireccion('');
      setOrigen({ lat, lng });
      limpiarResultados();
      setDireccion(texto || 'Ubicación seleccionada en el mapa');
      if (!texto) {
        const d = await direccionDesdeCoordenadas(lat, lng);
        // si mientras tanto se eligió otro origen, esta dirección ya no corresponde
        if (d && seq === origenSeq.current) setDireccion(d);
      }
    },
    [limpiarResultados]
  );

  // REQ-EP1-01: geolocalización con timeout de 5 s
  const usarMiUbicacion = useCallback((explicito = false) => {
    const fallar = () => {
      if (!explicito && origenManual.current) return;
      setModal({
        titulo: 'No pudimos acceder a tu ubicación',
        mensaje:
          'No se pudo acceder a tu ubicación actual. Por favor, selecciona un punto en el mapa o ingresa una dirección manualmente',
        acciones: [
          {
            label: 'Ingresar dirección',
            primario: true,
            onClick: () => {
              setModal(null);
              setEnfocarBuscador((n) => n + 1);
            },
          },
          { label: 'Elegir en el mapa', onClick: () => setModal(null) },
        ],
      });
    };
    if (!navigator.geolocation) return fallar();

    let respondido = false;
    const corte = setTimeout(() => {
      if (!respondido) {
        respondido = true;
        fallar();
      }
    }, 5000);

    navigator.geolocation.getCurrentPosition(
      (pos) => {
        if (respondido) return;
        respondido = true;
        clearTimeout(corte);
        // una respuesta tardía del GPS no debe pisar una dirección elegida a mano
        if (!explicito && origenManual.current) return;
        elegirOrigen(pos.coords.latitude, pos.coords.longitude, undefined, true);
      },
      () => {
        if (respondido) return;
        respondido = true;
        clearTimeout(corte);
        fallar();
      },
      { enableHighAccuracy: true, timeout: 5000, maximumAge: 30000 }
    );
  }, [elegirOrigen]);

  useEffect(() => {
    if (geoPedida.current) return;
    geoPedida.current = true;
    usarMiUbicacion(false);
  }, [usarMiUbicacion]);

  // REQ-EP2-01, EP3-01: búsqueda y recomendación
  const buscar = useCallback(
    async (radioOverride) => {
      if (!origen) return;
      const radioKm = radioOverride ?? params.radioKm;
      const comb = COMBUSTIBLES.find((c) => c.id === params.combustible) || COMBUSTIBLES[1];
      setBuscando(true);
      setErrorRuta('');
      setModal(null);

      const reintentar = () => buscar(radioOverride);
      try {
        const cercanas = await obtenerEstacionesCercanas({
          lat: origen.lat,
          lng: origen.lng,
          radioKm,
          tipoCombustible: comb.apiId,
        });
        const enCobertura = (cercanas.estaciones || []).filter((e) => dentroDeCobertura(e.lat, e.lng));

        if (enCobertura.length === 0) {
          const ampliado = Math.min(20, radioKm + 5);
          setModal({
            titulo: 'Sin estaciones disponibles',
            mensaje:
              ampliado > radioKm
                ? `No se encontraron estaciones en un radio de ${radioKm} km. ¿Deseas ampliar la búsqueda a ${ampliado} km?`
                : 'No se encontraron estaciones disponibles dentro del radio seleccionado',
            acciones: [
              ...(ampliado > radioKm
                ? [
                    {
                      label: `Ampliar a ${ampliado} km`,
                      primario: true,
                      onClick: () => {
                        setParams((p) => ({ ...p, radioKm: ampliado }));
                        buscar(ampliado);
                      },
                    },
                  ]
                : []),
              { label: 'Cerrar', onClick: () => setModal(null) },
            ],
          });
          return;
        }

        // RN-02: monto en pesos -> litros con el precio promedio de las candidatas
        const promedio = enCobertura.reduce((s, e) => s + e.precioLitro, 0) / enCobertura.length;
        let litros = DEFAULTS.litros;
        let litrosDesdeDinero = false;
        if (params.cantidad) {
          if (params.modo === 'dinero') {
            litros = parseMiles(params.cantidad) / promedio;
            litrosDesdeDinero = true;
          } else {
            litros = Number(String(params.cantidad).replace(',', '.'));
          }
        }

        const calculo = await calcularMejorOpcion({
          lat: origen.lat,
          lng: origen.lng,
          litrosACargar: litros,
          rendimientoKmL: Number(params.rendimiento),
          radioMaxKm: radioKm,
          tipoCombustible: comb.apiId,
        });
        // /calcular no devuelve coordenadas ni marca: se completan desde /estaciones-cercanas por id
        const porId = new Map(enCobertura.map((e) => [e.id, e]));
        const ranking = (calculo.ranking || [])
          .filter((e) => porId.has(e.id))
          .map((e) => {
            const { lat, lng, marca, comuna } = porId.get(e.id);
            return { ...e, lat, lng, marca, comuna };
          });

        if (ranking.length === 0) {
          setModal({
            titulo: 'Sin alternativas',
            mensaje: 'No se encontró ninguna alternativa disponible en este momento.',
            acciones: [{ label: 'Cerrar', onClick: () => setModal(null) }],
          });
          return;
        }

        // El ahorro se recalcula sobre las estaciones que quedaron dentro de la comuna
        const masCercana = [...ranking].sort((a, b) => a.distanciaKm - b.distanciaKm)[0];
        const conAhorro = ranking.map((e) => ({ ...e, ahorroVsMasCercana: masCercana.costoTotal - e.costoTotal }));

        setRuta(null);
        setRutaDeId(null);
        setSeleccionadaId(null);
        setResultado({
          ranking: conAhorro,
          mejorOpcion: conAhorro[0],
          litros,
          litrosDesdeDinero,
          combustibleLabel: comb.label,
          radioKm,
        });
        setVista('resultados');
        setEstadoSheet('medio');
      } catch {
        setModal({
          titulo: 'No fue posible obtener los datos',
          mensaje: 'No fue posible obtener los datos necesarios de estaciones y precios. Puedes reintentar la consulta.',
          acciones: [
            { label: 'Reintentar', primario: true, onClick: reintentar },
            { label: 'Cerrar', onClick: () => setModal(null) },
          ],
        });
      } finally {
        setBuscando(false);
      }
    },
    [origen, params]
  );

  // REQ-EP3-03: ruta hacia la estación elegida
  const verRuta = useCallback(
    async (estacion) => {
      if (!origen) return;
      setErrorRuta('');
      setCargandoRuta(estacion.id);
      setSeleccionadaId(estacion.id);
      try {
        const r = await obtenerRuta(origen, { lat: estacion.lat, lng: estacion.lng });
        setRuta(r);
        setRutaDeId(estacion.id);
        setEstadoSheet('minimizado'); // baja el panel para dejar ver la ruta en el mapa
      } catch {
        setRutaDeId(estacion.id);
        setErrorRuta('No fue posible mostrar la ruta seleccionada. Intenta nuevamente.');
      } finally {
        setCargandoRuta(null);
      }
    },
    [origen]
  );

  return (
    <main className="relative h-dvh w-full overflow-hidden">
      <MapView
        origen={origen}
        radioKm={params.radioKm}
        estaciones={resultado?.ranking}
        recomendadaId={resultado?.mejorOpcion.id}
        seleccionadaId={seleccionadaId}
        ruta={ruta}
        bottomInset={alturaSheet}
        onElegirOrigen={elegirOrigen}
        onSeleccionarEstacion={setSeleccionadaId}
      />

      {/* Barra superior de búsqueda */}
      <div className="pointer-events-none absolute inset-x-0 top-0 z-30 p-3 pt-[max(0.75rem,env(safe-area-inset-top))]">
        <SearchBar
          direccion={direccion}
          errorDireccion={errorDireccion}
          onElegir={elegirOrigen}
          onErrorUbicacion={() => setErrorDireccion(MSG_FUERA_COBERTURA)}
          autoFocus={enfocarBuscador}
        />
      </div>

      {/* Botón flotante: usar mi ubicación actual */}
      <button
        type="button"
        onClick={() => usarMiUbicacion(true)}
        aria-label="Usar mi ubicación actual"
        title="Usar mi ubicación actual"
        className="absolute right-3 z-30 flex h-12 w-12 items-center justify-center rounded-full bg-white text-xl text-blue-600 shadow-lg ring-1 ring-slate-200"
        style={{ bottom: alturaSheet + 16 }}
      >
        ◎
      </button>

      {aviso && (
        <div role="status" className="absolute inset-x-0 top-24 z-30 mx-auto w-fit max-w-[90%] rounded-full bg-slate-900 px-4 py-2 text-sm text-white shadow-lg">
          {aviso}
        </div>
      )}

      <BottomSheet estado={estadoSheet} onEstado={setEstadoSheet} onAltura={setAlturaSheet}>
        {vista === 'resultados' && resultado ? (
          <Resultados
            resultado={resultado}
            seleccionadaId={seleccionadaId}
            rutaDeId={rutaDeId}
            errorRuta={errorRuta}
            cargandoRuta={cargandoRuta}
            onSeleccionar={setSeleccionadaId}
            onVerRuta={verRuta}
            onModificar={() => {
              setVista('parametros');
              setEstadoSheet('expandido');
            }}
          />
        ) : (
          <>
            {resultado && (
              <button
                type="button"
                onClick={() => {
                  setVista('resultados');
                  setEstadoSheet('medio');
                }}
                className="mb-3 h-10 w-full rounded-xl bg-slate-100 text-sm font-semibold text-slate-700"
              >
                ← Volver a resultados
              </button>
            )}
            <ParamsPanel
              params={params}
              onCambio={setParams}
              onBuscar={() => buscar()}
              buscando={buscando}
              origenListo={Boolean(origen)}
            />
          </>
        )}
      </BottomSheet>

      {modal && <Modal {...modal} onCerrar={() => setModal(null)} />}
    </main>
  );
}
</file>

<file path="components/BottomSheet.js">
'use client';

import { useEffect, useRef, useState } from 'react';

// Panel inferior con 3 estados: minimizado, medio y expandido (10.1)
const ESTADOS = ['minimizado', 'medio', 'expandido'];
const ALTURA_MIN = 76;

export default function BottomSheet({ estado, onEstado, onAltura, children }) {
  const [alto, setAlto] = useState(0);
  const [arrastre, setArrastre] = useState(null);
  const inicio = useRef(null);

  useEffect(() => {
    const calc = () => setAlto(window.innerHeight);
    calc();
    window.addEventListener('resize', calc);
    return () => window.removeEventListener('resize', calc);
  }, []);

  const alturas = {
    minimizado: ALTURA_MIN,
    medio: Math.round(alto * 0.45),
    expandido: Math.round(alto * 0.88),
  };
  const actual = arrastre ?? alturas[estado];

  useEffect(() => {
    if (alto) onAltura?.(alturas[estado]);
  }, [estado, alto]); // eslint-disable-line react-hooks/exhaustive-deps

  function bajar(e) {
    inicio.current = { y: e.clientY, h: alturas[estado], movido: false };
    e.currentTarget.setPointerCapture(e.pointerId);
  }
  function mover(e) {
    if (!inicio.current) return;
    const dy = inicio.current.y - e.clientY;
    if (Math.abs(dy) > 4) inicio.current.movido = true;
    setArrastre(Math.max(ALTURA_MIN, Math.min(alturas.expandido, inicio.current.h + dy)));
  }
  function soltar() {
    if (!inicio.current) return;
    const { movido } = inicio.current;
    if (movido && arrastre !== null) {
      // snap al estado más cercano
      const masCercano = ESTADOS.reduce((a, b) => (Math.abs(alturas[b] - arrastre) < Math.abs(alturas[a] - arrastre) ? b : a));
      onEstado(masCercano);
    } else {
      // tap en el asa: cicla minimizado -> medio -> expandido -> medio
      onEstado(estado === 'medio' ? 'expandido' : 'medio');
    }
    inicio.current = null;
    setArrastre(null);
  }

  return (
    <section
      className="absolute inset-x-0 bottom-0 z-20 flex flex-col rounded-t-3xl bg-white shadow-[0_-8px_30px_rgba(0,0,0,.18)]"
      style={{
        height: actual || ALTURA_MIN,
        transition: arrastre === null ? 'height 220ms ease' : 'none',
      }}
    >
      <div
        role="button"
        tabIndex={0}
        aria-label="Ajustar tamaño del panel"
        onPointerDown={bajar}
        onPointerMove={mover}
        onPointerUp={soltar}
        onPointerCancel={soltar}
        onKeyDown={(e) => {
          if (e.key === 'Enter' || e.key === ' ') onEstado(estado === 'medio' ? 'expandido' : 'medio');
        }}
        className="flex shrink-0 cursor-grab touch-none justify-center py-3 active:cursor-grabbing"
      >
        <span className="h-1.5 w-12 rounded-full bg-slate-300" />
      </div>
      <div className="min-h-0 flex-1 overflow-y-auto px-4 pb-[max(1rem,env(safe-area-inset-bottom))]">
        {children}
      </div>
    </section>
  );
}
</file>

<file path="components/MapView.js">
'use client';

import { useEffect, useRef, useState } from 'react';
import mapboxgl from 'mapbox-gl';
import 'mapbox-gl/dist/mapbox-gl.css';
import { MAPBOX_TOKEN, NUNOA_CENTER } from '../lib/config';

// Círculo geodésico aproximado como polígono GeoJSON (radio en km)
function circulo(lat, lng, radioKm, pasos = 64) {
  const coords = [];
  const dLat = radioKm / 111.32;
  const dLng = radioKm / (111.32 * Math.cos((lat * Math.PI) / 180));
  for (let i = 0; i <= pasos; i++) {
    const a = (i / pasos) * 2 * Math.PI;
    coords.push([lng + dLng * Math.cos(a), lat + dLat * Math.sin(a)]);
  }
  return { type: 'Feature', geometry: { type: 'Polygon', coordinates: [coords] } };
}

const VACIO = { type: 'FeatureCollection', features: [] };

function crearPin(color, texto) {
  const el = document.createElement('div');
  el.style.cssText = `
    width:30px;height:30px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);
    background:${color};border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.35);
    display:flex;align-items:center;justify-content:center;cursor:pointer;`;
  const t = document.createElement('span');
  t.textContent = texto;
  t.style.cssText = 'transform:rotate(45deg);color:#fff;font-weight:700;font-size:12px;';
  el.appendChild(t);
  return el;
}

export default function MapView({
  origen,
  radioKm,
  estaciones,
  recomendadaId,
  seleccionadaId,
  ruta,
  bottomInset,
  onElegirOrigen,
  onSeleccionarEstacion,
}) {
  const contenedor = useRef(null);
  const mapa = useRef(null);
  const listo = useRef(false);
  const marcadorOrigen = useRef(null);
  const marcadoresEstaciones = useRef([]);
  const cbOrigen = useRef(onElegirOrigen);
  const cbEstacion = useRef(onSeleccionarEstacion);
  const [sinToken] = useState(!MAPBOX_TOKEN);

  cbOrigen.current = onElegirOrigen;
  cbEstacion.current = onSeleccionarEstacion;

  // Inicialización única del mapa
  useEffect(() => {
    if (!MAPBOX_TOKEN || mapa.current) return;
    mapboxgl.accessToken = MAPBOX_TOKEN;

    const m = new mapboxgl.Map({
      container: contenedor.current,
      style: 'mapbox://styles/mapbox/streets-v12',
      center: [NUNOA_CENTER.lng, NUNOA_CENTER.lat],
      zoom: 13.5,
      attributionControl: false,
    });
    m.addControl(new mapboxgl.AttributionControl({ compact: true }), 'top-right');

    m.on('load', () => {
      m.addSource('radio', { type: 'geojson', data: VACIO });
      m.addLayer({
        id: 'radio-relleno',
        type: 'fill',
        source: 'radio',
        paint: { 'fill-color': '#2563eb', 'fill-opacity': 0.08 },
      });
      m.addLayer({
        id: 'radio-borde',
        type: 'line',
        source: 'radio',
        paint: { 'line-color': '#2563eb', 'line-width': 2 },
      });
      m.addSource('ruta', { type: 'geojson', data: VACIO });
      m.addLayer({
        id: 'ruta-borde',
        type: 'line',
        source: 'ruta',
        layout: { 'line-cap': 'round', 'line-join': 'round' },
        paint: { 'line-color': '#ffffff', 'line-width': 9 },
      });
      m.addLayer({
        id: 'ruta-linea',
        type: 'line',
        source: 'ruta',
        layout: { 'line-cap': 'round', 'line-join': 'round' },
        paint: { 'line-color': '#16a34a', 'line-width': 5 },
      });
      listo.current = true;
      m.fire('benci-listo');
    });

    // REQ-EP1-02: tap sobre el mapa fija el origen
    m.on('click', (e) => cbOrigen.current?.(e.lngLat.lat, e.lngLat.lng));

    mapa.current = m;
    return () => {
      // los marcadores pertenecen al mapa que se destruye: se descartan para recrearlos en el nuevo
      marcadorOrigen.current?.remove();
      marcadorOrigen.current = null;
      marcadoresEstaciones.current.forEach((x) => x.remove());
      marcadoresEstaciones.current = [];
      m.remove();
      mapa.current = null;
      listo.current = false;
    };
  }, []);

  // Marcador de origen (arrastrable) + círculo de radio
  useEffect(() => {
    const m = mapa.current;
    if (!m || !origen) return;

    const aplicar = () => {
      if (!marcadorOrigen.current) {
        const el = document.createElement('div');
        el.style.cssText =
          'width:20px;height:20px;border-radius:50%;background:#2563eb;border:3px solid #fff;box-shadow:0 0 0 6px rgba(37,99,235,.25);';
        marcadorOrigen.current = new mapboxgl.Marker({ element: el, draggable: true })
          .setLngLat([origen.lng, origen.lat])
          .addTo(m);
        marcadorOrigen.current.on('dragend', () => {
          const p = marcadorOrigen.current.getLngLat();
          cbOrigen.current?.(p.lat, p.lng);
        });
      } else {
        marcadorOrigen.current.setLngLat([origen.lng, origen.lat]);
      }
      m.getSource('radio')?.setData(circulo(origen.lat, origen.lng, radioKm));
    };

    if (listo.current) aplicar();
    else m.once('benci-listo', aplicar);
  }, [origen, radioKm]);

  // Recentrado suave cuando cambia el origen
  useEffect(() => {
    const m = mapa.current;
    if (!m || !origen) return;
    m.easeTo({
      center: [origen.lng, origen.lat],
      duration: 800,
      padding: { top: 90, bottom: bottomInset || 0, left: 0, right: 0 },
    });
  }, [origen?.lat, origen?.lng]); // eslint-disable-line react-hooks/exhaustive-deps

  // Marcadores de estaciones
  useEffect(() => {
    const m = mapa.current;
    if (!m) return;
    marcadoresEstaciones.current.forEach((x) => x.remove());
    marcadoresEstaciones.current = [];

    (estaciones || []).forEach((e, i) => {
      const esRec = e.id === recomendadaId;
      const esSel = e.id === seleccionadaId;
      const el = crearPin(esRec ? '#16a34a' : esSel ? '#f59e0b' : '#64748b', esRec ? '★' : String(i + 1));
      el.addEventListener('click', (ev) => {
        ev.stopPropagation();
        cbEstacion.current?.(e.id);
      });
      const mk = new mapboxgl.Marker({ element: el, anchor: 'bottom' }).setLngLat([e.lng, e.lat]).addTo(m);
      marcadoresEstaciones.current.push(mk);
    });
  }, [estaciones, recomendadaId, seleccionadaId]);

  // Ruta hacia la estación elegida
  useEffect(() => {
    const m = mapa.current;
    if (!m) return;
    const aplicar = () => {
      m.getSource('ruta')?.setData(ruta ? { type: 'Feature', geometry: ruta.geometry } : VACIO);
      if (ruta && origen) {
        const b = new mapboxgl.LngLatBounds();
        ruta.geometry.coordinates.forEach((c) => b.extend(c));
        b.extend([origen.lng, origen.lat]); // el origen puede quedar fuera del trazo (se ajusta a la calle)
        m.fitBounds(b, { padding: { top: 100, bottom: (bottomInset || 0) + 30, left: 40, right: 40 }, duration: 900 });
      }
    };
    if (listo.current) aplicar();
    else m.once('benci-listo', aplicar);
  }, [ruta]); // eslint-disable-line react-hooks/exhaustive-deps

  if (sinToken) {
    return (
      <div className="absolute inset-0 flex items-center justify-center bg-slate-200 p-8 text-center">
        <div className="max-w-sm rounded-xl bg-white p-5 shadow">
          <p className="font-semibold">Falta el token de Mapbox</p>
          <p className="mt-2 text-sm text-slate-600">
            Crea el archivo <code>.env.local</code> en <code>benciruta-front</code> con{' '}
            <code>NEXT_PUBLIC_MAPBOX_TOKEN=pk...</code> y reinicia <code>npm run dev</code>.
          </p>
        </div>
      </div>
    );
  }

  // Mapbox fuerza position:relative en su contenedor, por eso va dentro de un envoltorio absoluto
  return (
    <div className="absolute inset-0">
      <div ref={contenedor} className="h-full w-full" />
    </div>
  );
}
</file>

