<file path="components/ParamsPanel.js">
'use client';

import { useState } from 'react';
import { COMBUSTIBLES } from '../lib/config';
import { VEHICULOS, rendimientoDe } from '../lib/vehiculos';
import { formatMiles, parseMiles } from '../lib/format';

export const MIN_DINERO = 1000;
export const MIN_LITROS = 1;

export function validarRendimiento(valor) {
  const n = Number(String(valor).replace(',', '.'));
  return !isNaN(n) && n >= 1 && n <= 50;
}

// Un valor vacío es válido: se asumen los 30 L por defecto
export function validarCantidad(modo, cantidad) {
  if (cantidad === '' || cantidad === undefined) return true;
  const n = modo === 'dinero' ? parseMiles(cantidad) : Number(String(cantidad).replace(',', '.'));
  if (isNaN(n)) return false;
  return n >= (modo === 'dinero' ? MIN_DINERO : MIN_LITROS);
}

function Bloque({ titulo, resumen, abierto, onToggle, children }) {
  return (
    <div className="rounded-2xl border border-slate-200 bg-slate-50">
      <button
        type="button"
        onClick={onToggle}
        aria-expanded={abierto}
        className="flex w-full items-center justify-between px-4 py-3 text-left"
      >
        <span className="font-semibold">{titulo}</span>
        <span className="flex items-center gap-2 text-sm text-slate-500">
          {!abierto && resumen}
          <span aria-hidden>{abierto ? '▲' : '▼'}</span>
        </span>
      </button>
      {abierto && <div className="space-y-3 px-4 pb-4">{children}</div>}
    </div>
  );
}

const campo =
  'h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-base outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 disabled:bg-slate-100 disabled:text-slate-400';

export default function ParamsPanel({ params, onCambio, onBuscar, buscando, origenListo }) {
  const [abiertos, setAbiertos] = useState({ vehiculo: true, combustible: true, volumen: true, radio: true });
  const [rendBorrador, setRendBorrador] = useState(String(params.rendimiento));

  const toggle = (k) => setAbiertos((a) => ({ ...a, [k]: !a[k] }));
  const set = (cambios) => onCambio({ ...params, ...cambios });

  const rendOk = validarRendimiento(rendBorrador);
  const cantidadOk = validarCantidad(params.modo, params.cantidad);
  const puedeBuscar = origenListo && validarRendimiento(params.rendimiento) && cantidadOk && !buscando;

  const marcas = Object.keys(VEHICULOS);
  const modelos = params.marca ? Object.keys(VEHICULOS[params.marca]) : [];
  const anios = params.marca && params.modelo ? Object.keys(VEHICULOS[params.marca][params.modelo]) : [];

  function elegirVehiculo(cambios) {
    const nuevo = { ...params, ...cambios };
    const r = rendimientoDe(nuevo.marca, nuevo.modelo, Number(nuevo.anio));
    if (r) setRendBorrador(String(r).replace('.', ','));
    onCambio({ ...nuevo, rendimiento: r ? String(r) : params.rendimiento });
  }

  const resumenVehiculo = `${String(params.rendimiento).replace('.', ',')} km/l`;
  const resumenComb = COMBUSTIBLES.find((c) => c.id === params.combustible)?.label;
  const resumenVol = params.cantidad
    ? params.modo === 'dinero'
      ? `$${params.cantidad}`
      : `${params.cantidad} L`
    : '30 L';

  return (
    <div className="space-y-3 pb-2">
      <h2 className="text-lg font-bold">¿Dónde te conviene cargar?</h2>

      {/* 1. Datos del vehículo */}
      <Bloque titulo="Datos del vehículo" resumen={resumenVehiculo} abierto={abiertos.vehiculo} onToggle={() => toggle('vehiculo')}>
        <div className="grid grid-cols-1 gap-2 sm:grid-cols-3">
          <select
            aria-label="Marca"
            className={campo}
            value={params.marca}
            onChange={(e) => elegirVehiculo({ marca: e.target.value, modelo: '', anio: '' })}
          >
            <option value="">Marca</option>
            {marcas.map((m) => (
              <option key={m}>{m}</option>
            ))}
          </select>
          <select
            aria-label="Modelo"
            className={campo}
            value={params.modelo}
            disabled={!params.marca}
            onChange={(e) => elegirVehiculo({ modelo: e.target.value, anio: '' })}
          >
            <option value="">Modelo</option>
            {modelos.map((m) => (
              <option key={m}>{m}</option>
            ))}
          </select>
          <select
            aria-label="Año"
            className={campo}
            value={params.anio}
            disabled={!params.modelo}
            onChange={(e) => elegirVehiculo({ anio: e.target.value })}
          >
            <option value="">Año</option>
            {anios.map((a) => (
              <option key={a}>{a}</option>
            ))}
          </select>
        </div>

        <div>
          <label htmlFor="rend" className="mb-1 block text-sm font-medium">
            Rendimiento promedio (km/l)
          </label>
          <input
            id="rend"
            inputMode="decimal"
            value={rendBorrador}
            onChange={(e) => setRendBorrador(e.target.value.replace(/[^\d.,]/g, ''))}
            aria-invalid={!rendOk}
            className={`${campo} ${rendOk ? '' : 'border-red-500 focus:border-red-500 focus:ring-red-200'}`}
          />
          {!rendOk && (
            <p role="alert" className="mt-1 text-sm text-red-600">
              Ingresa un rendimiento válido entre 1.0 y 50.0 km/l
            </p>
          )}
        </div>
        <button
          type="button"
          disabled={!rendOk}
          onClick={() => set({ rendimiento: rendBorrador.replace(',', '.') })}
          className="h-11 w-full rounded-xl bg-slate-900 font-semibold text-white disabled:bg-slate-300"
        >
          Guardar/Aplicar
        </button>
      </Bloque>

      {/* 2. Tipo de combustible */}
      <Bloque titulo="Tipo de combustible" resumen={resumenComb} abierto={abiertos.combustible} onToggle={() => toggle('combustible')}>
        <div role="radiogroup" aria-label="Tipo de combustible" className="flex gap-2 overflow-x-auto pb-1">
          {COMBUSTIBLES.map((c) => {
            const sel = params.combustible === c.id;
            return (
              <button
                key={c.id}
                type="button"
                role="radio"
                aria-checked={sel}
                onClick={() => set({ combustible: c.id })}
                className={`h-11 shrink-0 rounded-full px-4 text-sm font-semibold ${
                  sel ? 'bg-blue-600 text-white' : 'bg-white text-slate-700 ring-1 ring-slate-300'
                }`}
              >
                {c.label}
              </button>
            );
          })}
        </div>
      </Bloque>

      {/* 3. Volumen de carga */}
      <Bloque titulo="Volumen de carga" resumen={resumenVol} abierto={abiertos.volumen} onToggle={() => toggle('volumen')}>
        <div className="grid grid-cols-2 rounded-xl bg-slate-200 p-1" role="tablist" aria-label="Modo de ingreso">
          {[
            ['dinero', 'Monto en Dinero ($)'],
            ['litros', 'Litros Totales (L)'],
          ].map(([id, label]) => (
            <button
              key={id}
              type="button"
              role="tab"
              aria-selected={params.modo === id}
              onClick={() => set({ modo: id, cantidad: '' })}
              className={`h-9 rounded-lg text-sm font-semibold ${params.modo === id ? 'bg-white shadow' : 'text-slate-600'}`}
            >
              {label}
            </button>
          ))}
        </div>

        <div>
          <label htmlFor="cant" className="mb-1 block text-sm font-medium">
            {params.modo === 'dinero' ? 'Monto a cargar (CLP)' : 'Litros a cargar'}
          </label>
          <input
            id="cant"
            inputMode={params.modo === 'dinero' ? 'numeric' : 'decimal'}
            placeholder="30 L por defecto"
            value={params.cantidad}
            onChange={(e) =>
              set({
                cantidad:
                  params.modo === 'dinero'
                    ? formatMiles(e.target.value)
                    : e.target.value.replace(/[^\d.,]/g, ''),
              })
            }
            aria-invalid={!cantidadOk}
            className={`${campo} ${cantidadOk ? '' : 'border-red-500 focus:border-red-500 focus:ring-red-200'}`}
          />
          {!cantidadOk && (
            <p role="alert" className="mt-1 text-sm text-red-600">
              El monto mínimo de carga debe ser mayor o igual a $1.000 CLP o 1 Litro
            </p>
          )}
        </div>

        <div className="flex flex-wrap gap-2">
          {[10000, 20000].map((monto) => (
            <button
              key={monto}
              type="button"
              onClick={() => {
                const base = params.modo === 'dinero' ? parseMiles(params.cantidad) || 0 : 0;
                set({ modo: 'dinero', cantidad: formatMiles(String(base + monto)) });
              }}
              className="h-10 rounded-full bg-white px-4 text-sm font-semibold ring-1 ring-slate-300"
            >
              +${monto.toLocaleString('es-CL')}
            </button>
          ))}
          <button
            type="button"
            onClick={() => set({ modo: 'litros', cantidad: '40' })}
            className="h-10 rounded-full bg-white px-4 text-sm font-semibold ring-1 ring-slate-300"
          >
            +Llenar estanque (40 L)
          </button>
        </div>
      </Bloque>

      {/* 4. Radio de búsqueda */}
      <Bloque titulo="Radio de búsqueda" resumen={`${params.radioKm} km`} abierto={abiertos.radio} onToggle={() => toggle('radio')}>
        <div className="flex items-center justify-between text-sm">
          <label htmlFor="radio">Distancia máxima</label>
          <strong>{params.radioKm} km</strong>
        </div>
        <input
          id="radio"
          type="range"
          min="1"
          max="20"
          step="1"
          value={params.radioKm}
          onChange={(e) => set({ radioKm: Number(e.target.value) })}
          className="h-8 w-full accent-blue-600"
        />
        <div className="flex justify-between text-xs text-slate-500">
          <span>1 km</span>
          <span>20 km</span>
        </div>
      </Bloque>

      <button
        type="button"
        disabled={!puedeBuscar}
        onClick={onBuscar}
        className="h-14 w-full rounded-2xl bg-blue-600 text-lg font-bold text-white shadow disabled:bg-slate-300"
      >
        {buscando ? 'Buscando…' : 'Buscar mejor opción'}
      </button>
      {!origenListo && (
        <p className="text-center text-sm text-slate-500">Define un origen en el mapa o en el buscador para continuar.</p>
      )}
    </div>
  );
}
</file>

<file path="components/Resultados.js">
'use client';

import { formatCLP, formatKm } from '../lib/format';

function Dato({ etiqueta, valor, destacado }) {
  return (
    <div>
      <dt className="text-xs text-slate-500">{etiqueta}</dt>
      <dd className={destacado ? 'text-lg font-bold' : 'font-semibold'}>{valor}</dd>
    </div>
  );
}

function TarjetaRecomendada({ e, litros, combustibleLabel, activa, errorRuta, cargandoRuta, onVerRuta }) {
  return (
    <article className="rounded-3xl border-2 border-green-500 bg-green-50 p-4 shadow-md">
      <p className="text-xs font-bold uppercase tracking-wide text-green-700">★ Estación recomendada</p>
      <h3 className="mt-1 text-xl font-bold">{e.marca || e.nombre}</h3>
      <p className="text-sm text-slate-600">
        {e.direccion}
        {e.comuna ? `, ${e.comuna}` : ''}
      </p>

      <dl className="mt-3 grid grid-cols-2 gap-3">
        <Dato etiqueta="Distancia desde el origen" valor={formatKm(e.distanciaKm)} />
        <Dato etiqueta={`Precio ${combustibleLabel}`} valor={`${formatCLP(e.precioLitro)}/L`} />
        <Dato etiqueta="Costo de traslado" valor={formatCLP(e.costoViaje)} />
        <Dato etiqueta={`Carga (${litros.toFixed(1).replace('.', ',')} L)`} valor={formatCLP(e.costoCarga)} />
        <Dato etiqueta="Costo total estimado" valor={formatCLP(e.costoTotal)} destacado />
        <Dato
          etiqueta="Ahorro vs. la más cercana"
          valor={e.ahorroVsMasCercana > 0 ? formatCLP(e.ahorroVsMasCercana) : 'Es la más cercana'}
          destacado
        />
      </dl>

      <button
        type="button"
        onClick={() => onVerRuta(e)}
        disabled={cargandoRuta}
        className="mt-4 h-12 w-full rounded-xl bg-green-600 font-bold text-white disabled:opacity-60"
      >
        {cargandoRuta ? 'Calculando ruta…' : activa ? 'Mostrando ruta ✓' : 'Ver ruta'}
      </button>
      {errorRuta && (
        <p role="alert" className="mt-2 text-sm font-medium text-red-600">
          {errorRuta}
        </p>
      )}
    </article>
  );
}

function TarjetaAlterna({ e, indice, seleccionada, onSeleccionar, onVerRuta, cargandoRuta }) {
  return (
    <article
      className={`rounded-2xl border bg-white p-3 ${seleccionada ? 'border-amber-500 ring-2 ring-amber-200' : 'border-slate-200'}`}
    >
      <button type="button" onClick={() => onSeleccionar(e.id)} className="block w-full text-left">
        <div className="flex items-start justify-between gap-3">
          <div className="min-w-0">
            <p className="truncate font-semibold">
              {indice}. {e.marca || e.nombre}
            </p>
            <p className="truncate text-sm text-slate-500">{e.direccion}</p>
          </div>
          <p className="shrink-0 font-bold">{formatCLP(e.costoTotal)}</p>
        </div>
        <p className="mt-1 text-sm text-slate-600">
          {formatKm(e.distanciaKm)} · {formatCLP(e.precioLitro)}/L · traslado {formatCLP(e.costoViaje)}
        </p>
      </button>
      <button
        type="button"
        onClick={() => onVerRuta(e)}
        disabled={cargandoRuta}
        className="mt-2 h-10 w-full rounded-lg bg-slate-100 text-sm font-semibold disabled:opacity-60"
      >
        Ver ruta
      </button>
    </article>
  );
}

export default function Resultados({
  resultado,
  seleccionadaId,
  rutaDeId,
  errorRuta,
  cargandoRuta,
  onSeleccionar,
  onVerRuta,
  onModificar,
}) {
  const { mejorOpcion, ranking, litros, combustibleLabel, radioKm, litrosDesdeDinero } = resultado;
  const otras = ranking.filter((e) => e.id !== mejorOpcion.id);

  return (
    <div className="space-y-4 pb-2">
      {/* Barra fija: visible también con el panel minimizado */}
      <div className="sticky top-0 z-10 -mx-4 flex items-center justify-between gap-2 bg-white px-4 pb-2">
        <h2 className="font-bold">Resultados</h2>
        <button
          type="button"
          onClick={onModificar}
          className="h-9 rounded-full bg-blue-600 px-4 text-sm font-semibold text-white"
        >
          ✎ Modificar búsqueda
        </button>
      </div>

      {litrosDesdeDinero && (
        <p className="rounded-xl bg-slate-100 px-3 py-2 text-xs text-slate-600">
          Tu monto equivale a ~{litros.toFixed(1).replace('.', ',')} L, según el precio promedio de las estaciones del radio.
        </p>
      )}

      <TarjetaRecomendada
        e={mejorOpcion}
        litros={litros}
        combustibleLabel={combustibleLabel}
        activa={rutaDeId === mejorOpcion.id}
        errorRuta={rutaDeId === mejorOpcion.id || !rutaDeId ? errorRuta : null}
        cargandoRuta={cargandoRuta === mejorOpcion.id}
        onVerRuta={onVerRuta}
      />

      {otras.length > 0 && (
        <section>
          <h3 className="mb-2 font-semibold">Otras estaciones en {radioKm} km</h3>
          <div className="space-y-2">
            {otras.map((e, i) => (
              <TarjetaAlterna
                key={e.id}
                e={e}
                indice={i + 2}
                seleccionada={seleccionadaId === e.id}
                cargandoRuta={Boolean(cargandoRuta)}
                onSeleccionar={onSeleccionar}
                onVerRuta={onVerRuta}
              />
            ))}
          </div>
          {errorRuta && rutaDeId && rutaDeId !== mejorOpcion.id && (
            <p role="alert" className="mt-2 text-sm font-medium text-red-600">
              {errorRuta}
            </p>
          )}
        </section>
      )}
    </div>
  );
}
</file>

<file path="components/SearchBar.js">
'use client';

import { useEffect, useRef, useState } from 'react';
import { buscarDirecciones, ubicacionDeSugerencia } from '../lib/api';

// REQ-EP1-02: "Origen de búsqueda" con autocompletado desde 3 caracteres
export default function SearchBar({ direccion, errorDireccion, onElegir, onErrorUbicacion, autoFocus }) {
  const [texto, setTexto] = useState('');
  const [sugerencias, setSugerencias] = useState([]);
  const [abierto, setAbierto] = useState(false);
  const ref = useRef(null);

  useEffect(() => {
    // no pisar lo que el usuario está escribiendo en este momento
    if (direccion && document.activeElement !== ref.current) setTexto(direccion);
  }, [direccion]);

  useEffect(() => {
    if (autoFocus) ref.current?.focus();
  }, [autoFocus]);

  useEffect(() => {
    if (!abierto || texto.trim().length < 3) {
      setSugerencias([]);
      return;
    }
    const ctrl = new AbortController();
    const t = setTimeout(async () => {
      try {
        setSugerencias(await buscarDirecciones(texto.trim(), ctrl.signal));
      } catch {
        /* petición cancelada */
      }
    }, 250);
    return () => {
      clearTimeout(t);
      ctrl.abort();
    };
  }, [texto, abierto]);

  async function elegir(s) {
    setTexto(s.texto);
    setAbierto(false);
    setSugerencias([]);
    ref.current?.blur();
    try {
      const { lat, lng } = await ubicacionDeSugerencia(s.id);
      onElegir(lat, lng, s.texto);
    } catch {
      onErrorUbicacion?.();
    }
  }

  return (
    <div className="pointer-events-auto relative">
      <label htmlFor="origen" className="sr-only">
        Origen de búsqueda
      </label>
      <div className="flex items-center rounded-xl bg-white px-3 shadow-lg ring-1 ring-slate-200">
        <span aria-hidden className="mr-2 text-blue-600">
          ⌖
        </span>
        <input
          id="origen"
          ref={ref}
          value={texto}
          onChange={(e) => {
            setTexto(e.target.value);
            setAbierto(true);
          }}
          onFocus={() => setAbierto(true)}
          onKeyDown={(e) => {
            // Enter elige la primera sugerencia
            if (e.key === 'Enter' && sugerencias[0]) {
              e.preventDefault();
              elegir(sugerencias[0]);
            }
          }}
          placeholder="Origen de búsqueda"
          autoComplete="off"
          className="h-12 w-full bg-transparent text-base outline-none"
        />
        {texto && (
          <button
            type="button"
            aria-label="Borrar"
            onClick={() => {
              setTexto('');
              setSugerencias([]);
              ref.current?.focus();
            }}
            className="px-2 text-slate-400"
          >
            ✕
          </button>
        )}
      </div>

      {abierto && sugerencias.length > 0 && (
        <ul className="absolute left-0 right-0 z-10 mt-1 overflow-hidden rounded-xl bg-white shadow-lg ring-1 ring-slate-200">
          {sugerencias.map((s) => (
            <li key={s.id}>
              <button
                type="button"
                className="block w-full px-4 py-3 text-left text-sm hover:bg-slate-50"
                onClick={() => elegir(s)}
              >
                {s.texto}
              </button>
            </li>
          ))}
        </ul>
      )}

      {errorDireccion && (
        <p role="alert" className="mt-1 rounded-lg bg-white/95 px-3 py-2 text-sm font-medium text-red-600 shadow">
          {errorDireccion}
        </p>
      )}
    </div>
  );
}
</file>

